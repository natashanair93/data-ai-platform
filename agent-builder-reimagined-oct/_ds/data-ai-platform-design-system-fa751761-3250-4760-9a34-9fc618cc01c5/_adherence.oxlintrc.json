{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/display/**",
              "components/forms/**",
              "components/foundations/**",
              "ui_kits/data-ai-platform/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Open Sans|Archivo|PT Mono|PT Serif))/i]",
        "message": "Font not provided by the design system. Available: Open Sans, Archivo, PT Mono, PT Serif."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|count|status|max|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, count, status, max, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:neutral|info|success|warning|error)$/]",
        "message": "<Badge> status must be one of 'neutral' | 'info' | 'success' | 'warning' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|appearance|sentiment|disabled|fullWidth|startIcon|endIcon|onClick|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, appearance, sentiment, disabled, fullWidth, startIcon, endIcon, onClick, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='appearance'] > Literal[value!=/^(?:solid|bordered|transparent)$/]",
        "message": "<Button> appearance must be one of 'solid' | 'bordered' | 'transparent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='sentiment'] > Literal[value!=/^(?:accented|neutral|positive|negative|caution)$/]",
        "message": "<Button> sentiment must be one of 'accented' | 'neutral' | 'positive' | 'negative' | 'caution'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|interactive|selected|accentBorder|padding|as|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, interactive, selected, accentBorder, padding, as, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|defaultChecked|indeterminate|disabled|label|count|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, defaultChecked, indeterminate, disabled, label, count, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dropdown'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|defaultValue|placeholder|disabled|onChange|fullWidth|style|key|ref|className|style|children)$/]",
        "message": "<Dropdown> doesn't accept that prop. Declared props: options, value, defaultValue, placeholder, disabled, onChange, fullWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|title|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|appearance|sentiment|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: children, appearance, sentiment, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='appearance'] > Literal[value!=/^(?:solid|bordered|transparent)$/]",
        "message": "<IconButton> appearance must be one of 'solid' | 'bordered' | 'transparent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='sentiment'] > Literal[value!=/^(?:accented|neutral|positive|negative|caution)$/]",
        "message": "<IconButton> sentiment must be one of 'accented' | 'neutral' | 'positive' | 'negative' | 'caution'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|defaultValue|placeholder|disabled|readOnly|validationStatus|startAdornment|endAdornment|onChange|fullWidth|style|inputStyle|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: value, defaultValue, placeholder, disabled, readOnly, validationStatus, startAdornment, endAdornment, onChange, fullWidth, style, inputStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='validationStatus'] > Literal[value!=/^(?:error|warning|success)$/]",
        "message": "<Input> validationStatus must be one of 'error' | 'warning' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|category|variant|startIcon|style|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: children, category, variant, startIcon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute[name.name='category'] > Literal[value!=/^(?:data|ai|governance|technical|documentation|neutral|dataset|dashboard|product|stream|model|agent|skill|glossary|process|report|application|api|notebook)$/]",
        "message": "<Pill> category must be one of 'data' | 'ai' | 'governance' | 'technical' | 'documentation' | 'neutral' | 'dataset' | 'dashboard' | 'product' | 'stream' | 'model' | 'agent' | 'skill' | 'glossary' | 'process' | 'report' | 'application' | 'api' | 'notebook'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:fill|outline|solid)$/]",
        "message": "<Pill> variant must be one of 'fill' | 'outline' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|defaultValue|placeholder|shortcut|size|showSend|onChange|onSubmit|style|key|ref|className|style|children)$/]",
        "message": "<SearchInput> doesn't accept that prop. Declared props: value, defaultValue, placeholder, shortcut, size, showSend, onChange, onSubmit, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchInput'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:large|medium)$/]",
        "message": "<SearchInput> size must be one of 'large' | 'medium'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|children|size|style|key|ref|className|style|children)$/]",
        "message": "<StatusIndicator> doesn't accept that prop. Declared props: status, children, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusIndicator'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:info|success|warning|error|neutral)$/]",
        "message": "<StatusIndicator> status must be one of 'info' | 'success' | 'warning' | 'error' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|count|icon|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: id, label, count, icon."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
